+    it("rejects Chief advice before creating a question", async () => {
+      await expect(
+        Promise.resolve().then(() => handler()({ agentId: "chief", question: "hi" }, api(labels))),
+      ).rejects.toThrow("/btw is disabled in Chief");
+      expect(addQuestion).not.toHaveBeenCalled();
+      expect(startQuestion).not.toHaveBeenCalled();
+    });
+  it("allows Bot advice", async () => {
+    await expect(
+      Promise.resolve().then(() =>
+        handler()({ agentId: "bot", question: "hi" }, api({ "paseo-bots.bot": "ordinary" })),
+      ),
+    ).resolves.toEqual({ questionId: "q" });
+    expect(startQuestion).toHaveBeenCalled();
+  });
+  it("preserves explicit work mode", async () => {
+    await expect(
+      Promise.resolve().then(() =>
+        handler()(
+          { agentId: "chief", question: "hi", mode: "work" },
+          api({ "paseo-bots.bot": "vibing-chief" }),
+        ),
+      ),
+    ).resolves.toEqual({ questionId: "q" });
+  });
+  for (const chief of [true, false])
+    it(`registers appropriate commands in ${chief ? "Chief" : "Bot"} view`, () => {
+      vi.stubGlobal("location", { search: chief ? "?view=chief" : "?view=bots" });
+      const commands: string[] = [];
+      const context = new Proxy(
+        {},
+        {
+          get: (_, key) =>
+            key === "addSlashCommand"
+              ? (c: any) => {
+                  commands.push(c.name);
+                  return () => {};
+                }
+              : () => () => {},
+        },
+      );
+      registerUi(context as any);
+      expect(commands.includes("btw")).toBe(!chief);
+      expect(commands).toContain("side");
+      expect(commands).toContain("fork");
+    });
