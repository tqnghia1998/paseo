@@ -0,0 +1,209 @@
+import { afterEach, expect, it, vi } from "vitest";
+import { mkdir, mkdtemp, readFile, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { PluginServerContext } from "@getpaseo/plugin/server";
+import type { PersistedState } from "./persist";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+const finishes: Array<() => void> = [];
+const cleanups: Array<() => void> = [];
+afterEach(async () => {
+  for (const finish of finishes.splice(0)) finish();
+  await new Promise((resolve) => setTimeout(resolve, 10));
+  for (const cleanup of cleanups.splice(0)) cleanup();
+  await new Promise((resolve) => setTimeout(resolve, 10));
+  vi.unstubAllEnvs();
+});
+
+const saved: PersistedState = {
+  version: 1,
+  questions: [
+    {
+      id: "saved",
+      agentId: "parent",
+      threadId: "saved-child",
+      mode: "advice",
+      question: "old question",
+      status: "done",
+      answer: "old answer",
+      error: null,
+      model: "m",
+      startedAt: 1,
+      finishedAt: 2,
+      elapsedMs: 1,
+      requestedModel: null,
+      tempAgentId: "saved-child",
+      threadTarget: null,
+    },
+  ],
+  threads: [
+    {
+      id: "saved-child",
+      agentId: "parent",
+      provider: "codex",
+      model: "m",
+      mode: "advice",
+      firstQuestion: "old question",
+    },
+  ],
+};
+async function fixture(
+  previous?: PersistedState,
+  failFirstCreate = false,
+  archiveWait?: Promise<void>,
+) {
+  vi.resetModules();
+  const home = await mkdtemp(join(tmpdir(), "sidechat-regression-"));
+  vi.stubEnv("PASEO_HOME", home);
+  const file = join(home, "plugin-data/paseo-sidechat/history.json");
+  if (previous) {
+    await mkdir(join(home, "plugin-data/paseo-sidechat"), { recursive: true });
+    await writeFile(file, JSON.stringify(previous));
+  }
+  const { default: contribute } = await import("../index.server");
+  const store = await import("./store");
+  const handlers = new Map<string, (input: unknown, context: unknown) => unknown>();
+  const cleanup = contribute({
+    registerSettings: () => ({
+      read: async () => ({
+        status: "ready",
+        values: { autoArchive: false, idleMinutes: 10, contextMessages: 8, attachToMain: true },
+      }),
+      subscribe: () => () => {},
+    }),
+    handle: (rpc: { name: string }, fn: (input: unknown, context: unknown) => unknown) =>
+      handlers.set(rpc.name, fn),
+  } as unknown as PluginServerContext);
+  cleanups.push(cleanup);
+  const created: string[] = [],
+    archived: string[] = [],
+    sent: string[] = [];
+  const handles = new Map();
+  function child(id: string) {
+    const end = deferred<{ status: "idle"; lastMessage: string }>();
+    finishes.push(() => end.resolve({ status: "idle", lastMessage: "finished" }));
+    const handle = {
+      id,
+      run: (question: string) => {
+        sent.push(question);
+        return end.promise;
+      },
+      send: async (question: string) => {
+        sent.push(question);
+      },
+      waitForFinish: () => end.promise,
+      timeline: { refetch: async () => ({ entries: [] }) },
+      archive: async () => {
+        archived.push(id);
+        if (id === "saved-child") await archiveWait;
+      },
+    };
+    handles.set(id, handle);
+    return handle;
+  }
+  for (const thread of previous?.threads ?? []) child(thread.id);
+  const paseo = {
+    agents: {
+      list: async () => ({
+        entries: (previous?.threads ?? []).map((thread) => ({
+          agent: { id: thread.id, labels: { btw: "side-question" } },
+        })),
+      }),
+      ref: (id: string) =>
+        handles.get(id) ?? {
+          refresh: async () => ({
+            agent: {
+              id,
+              workspaceId: "ws",
+              provider: "codex",
+              model: "m",
+              labels: { "paseo-bots.bot": "ordinary" },
+            },
+          }),
+          timeline: { refetch: async () => ({ entries: [] }) },
+        },
+    },
+    providers: { listModes: async () => ({ modes: [] }) },
+    workspaces: {
+      ref: () => ({
+        agents: {
+          create: async () => {
+            if (failFirstCreate) {
+              failFirstCreate = false;
+              throw new Error("create failed");
+            }
+            const id = `child-${created.length}`;
+            created.push(id);
+            return child(id);
+          },
+        },
+      }),
+    },
+  };
+  return {
+    file,
+    store,
+    cleanup,
+    created,
+    archived,
+    sent,
+    ask: async (question: string, mode: "advice" | "work" = "advice", model?: string) =>
+      handlers.get("sidechat.ask")!({ agentId: "parent", question, mode, model }, { paseo }),
+  };
+}
+
+it("first question restores saved history before persistence and stale-thread cleanup", async () => {
+  const f = await fixture(saved);
+  await f.ask("new question");
+  await vi.waitFor(() => expect(f.sent).toEqual(["new question"]));
+  await f.store.flushSave();
+  const disk: PersistedState = JSON.parse(await readFile(f.file, "utf8"));
+  expect(disk.questions.find((q) => q.id === "saved")?.answer).toBe("old answer");
+  expect(f.archived).not.toContain("saved-child");
+  expect(f.created).toHaveLength(0);
+});
+it("overlapping first questions share one helper and steer the second question", async () => {
+  const f = await fixture();
+  await Promise.all([f.ask("one"), f.ask("two")]);
+  await vi.waitFor(() => expect(f.sent).toEqual(["two"]));
+  expect(f.created).toHaveLength(1);
+  expect(f.store.listOpenThreads("parent")).toHaveLength(1);
+});
+it("a failed creation releases its lane so the next question can start", async () => {
+  const f = await fixture(undefined, true);
+  await f.ask("one");
+  await vi.waitFor(() => expect(f.store.listQuestionsForAgent("parent")[0]?.status).toBe("error"));
+  await f.ask("two");
+  await vi.waitFor(() => expect(f.created).toHaveLength(1));
+});
+it("unloading before any RPC preserves saved history", async () => {
+  const f = await fixture(saved);
+  f.cleanup();
+  await f.store.flushSave();
+  const disk: PersistedState = JSON.parse(await readFile(f.file, "utf8"));
+  expect(disk.questions.find((q) => q.id === "saved")?.answer).toBe("old answer");
+});
+
+it("model replacement reserves the lane while retiring the previous helper", async () => {
+  const archive = deferred<void>();
+  const f = await fixture(saved, false, archive.promise);
+  try {
+    await f.ask("one", "advice", "new-model");
+    await vi.waitFor(() => expect(f.archived).toContain("saved-child"));
+    await f.ask("two", "advice", "new-model");
+    await new Promise((resolve) => setImmediate(resolve));
+    expect(f.created).toHaveLength(0);
+    archive.resolve();
+    await vi.waitFor(() => expect(f.sent).toEqual(["two"]));
+    expect(f.created).toHaveLength(1);
+  } finally {
+    archive.resolve();
+  }
+});
