+  openThreadAgentIds: vi.fn(),
+  runningTempAgentIds: vi.fn(),
+}));
+import contribute from "./index.server";
+import { registerUi } from "./client/ui-registration";
+import { addQuestion } from "./server/store";
+import { startQuestion } from "./server/runner";
+function handler() {
+  const handlers = new Map();
+  contribute({
+    registerSettings: () => ({ read: async () => ({ status: "ready" }), subscribe: () => {} }),
+    handle: (rpc: any, fn: any) => handlers.set(rpc.name, fn),
+  } as any);
+  return handlers.get("sidechat.ask");
+}
+const api = (labels: Record<string, string | undefined>) => ({
+  paseo: { agents: { ref: () => ({ refresh: async () => ({ agent: { labels } }) }) } },
+});
+beforeEach(() => {
