+
+function hasBotsInteractionReceipt(output: unknown): boolean {
+  let visited = 0;
+  const check = (value: unknown, depth = 0): boolean => {
+    if (depth > 5 || ++visited > 32) return false;
+    if (typeof value === "string") {
+      if (value.length > 200_000) return false;
+      try {
+        return check(JSON.parse(value), depth + 1);
+      } catch {
+        return false;
+      }
+    }
+    if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+    const record = value as Record<string, unknown>;
+    if (record.isError === true) return false;
+    if (
+      typeof record.cardId === "string" &&
+      BOTS_INTERACTION_ID.test(record.cardId) &&
+      BOTS_INTERACTION_STATUSES.has(String(record.status))
+    ) {
+      return true;
+    }
+    if (Array.isArray(record.content)) {
+      for (const block of record.content.slice(0, 20)) {
+        if (
+          block &&
+          typeof block === "object" &&
+          (block as { type?: unknown }).type === "text" &&
+          check((block as { text?: unknown }).text, depth + 1)
+        ) {
+          return true;
+        }
+      }
+    }
+    return false;
+  };
+  return check(output);
+}
