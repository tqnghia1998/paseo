+++ b/client/i18n/file-open-error.ts
@@ -5,6 +5,36 @@ import type { FileOpenErrorKind } from "../../shared/file-rpc";
 
 type RevealResult = { error: string | null; errorKind?: FileOpenErrorKind; errorApp?: FileOpenApp; errorCode?: "system_opener_unavailable" };
 
+function tryOpenInEmbeddedHost(cwd: string, rawPath: string): boolean {
+  if (typeof window === "undefined" || window.parent === window || !cwd) return false;
+  if (typeof window.name !== "string" || !window.name.startsWith("paseo-workspace:bots:")) return false;
+  let origin: string | null = null;
+  try {
+    origin = document.referrer
+      ? new URL(document.referrer).origin
+      : (window.location.ancestorOrigins?.[0] ?? null);
+  } catch {
+    return false;
+  }
+  if (!origin) return false;
+  const trimmed = rawPath.trim();
+  const match = /^(.*?)(?:(?::|#L)(\d+)(?:[:-]L?\d+)*)?$/.exec(trimmed);
+  const candidate = (match?.[1] || trimmed).trim();
+  const line = match?.[2] ? Math.max(1, Number.parseInt(match[2], 10) || 1) : 1;
+  const root = cwd.replace(/\/+$/, "");
+  let relative = candidate;
+  if (candidate.startsWith("/")) {
+    if (!root || !candidate.startsWith(`${root}/`)) return false;
+    relative = candidate.slice(root.length + 1);
+  }
+  relative = relative.replace(/^(?:\.\/)+/, "");
+  if (!relative || /^([/\\]|[a-zA-Z]:)/.test(relative) || relative.split(/[/\\]/).includes("..")) {
+    return false;
+  }
+  window.parent.postMessage({ type: "paseo:open-file", path: relative, line }, origin);
+  return true;
+}
+
 /**
  * A path press: opens or reveals the path on the host with the current file
  * open setting, and shows any failure in a toast.
@@ -15,7 +45,9 @@ export function revealWithSetting(
   cwd: string,
   path: string,
 ): void {
-  void revealPath({ cwd, path, expectedApp: getEnhancerPreferences().fileOpenApp })
+  const expectedApp = getEnhancerPreferences().fileOpenApp;
+  if (expectedApp === "system" && tryOpenInEmbeddedHost(cwd, path)) return;
+  void revealPath({ cwd, path, expectedApp })
     .then((result) => { if (result.error) toast.error(fileOpenError(result)); })
     .catch((error: unknown) => toast.error(String(error)));
 }
