diff --git a/test/checkout-baseline.test.ts b/test/checkout-baseline.test.ts
new file mode 100644
index 0000000..bfdd51a
--- /dev/null
+++ b/test/checkout-baseline.test.ts
@@ -0,0 +1,82 @@
+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, mkdirSync, writeFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import { excludeCheckoutBaseline } from '../server/checkout-baseline';
+import { createTurnDocs } from '../server/turn-docs';
+import { scannedDocuments } from '../server/recent';
+import type { TurnDocsFile } from '../shared/turn-docs';
+
+const roots: string[] = [];
+afterEach(() => { for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true }); });
+function fixture() {
+  const root = mkdtempSync(join(tmpdir(), 'checkout-baseline-')); roots.push(root);
+  let repo = join(root, 'origin'); mkdirSync(repo);
+  const git = (...args: string[]) => execFileSync('git', ['-c', 'core.hooksPath=/dev/null', '-C', repo, ...args], { env: { ...process.env, GIT_CONFIG_GLOBAL: '/dev/null', GIT_CONFIG_SYSTEM: '/dev/null' } });
+  git('init', '-q');
+  for (const path of ['logo.png', 'edited.png', 'staged.png']) writeFileSync(join(repo, path), 'original');
+  git('add', '.'); git('-c', 'user.name=Test', '-c', 'user.email=test@example.com', '-c', 'commit.gpgsign=false', 'commit', '-qm', 'baseline');
+  execFileSync('git', ['-c', 'core.hooksPath=/dev/null', 'clone', '-q', '--local', repo, join(root, 'project')]);
+  repo = join(root, 'project');
+  return { root, repo, git };
+}
+const files = (...paths: string[]): TurnDocsFile[] => paths.map(path => ({ path, kind: 'image-raster', size: 8, revision: 'r', status: 'new' }));
+
+describe('checkout files are a baseline, not agent artifacts', () => {
+  it('removes untouched checkout assets while keeping edits, staged edits and new files', async () => {
+    const { root, repo, git } = fixture();
+    writeFileSync(join(repo, 'edited.png'), 'edit'); writeFileSync(join(repo, 'staged.png'), 'staged'); git('add', 'staged.png');
+    git('-c', 'user.name=Test', '-c', 'user.email=test@example.com', '-c', 'commit.gpgsign=false', 'commit', '-qm', 'later edit');
+    writeFileSync(join(repo, 'new.png'), 'new');
+    writeFileSync(join(repo, '.gitignore'), 'ignored.png');
+    writeFileSync(join(repo, 'ignored.png'), 'generated report');
+    const changed = files('project/logo.png', 'project/edited.png', 'project/staged.png', 'project/new.png', 'project/ignored.png', 'report.png');
+    const result = await excludeCheckoutBaseline(root, changed, { dirs: new Map([['project', Date.now()]]), repos: new Set(['project']) }, { revisions: new Map(), dirs: new Set(), complete: true }, Date.now());
+    expect(result.map(file => file.path)).toEqual(['project/edited.png', 'project/staged.png', 'project/new.png', 'project/ignored.png', 'report.png']);
+  });
+  it('keeps existing-repo changes and files when Git cannot establish a baseline', async () => {
+    const { root } = fixture();
+    const changed = files('project/logo.png');
+    const after = { dirs: new Map([['project', Date.now()]]), repos: new Set(['project']) };
+    expect(await excludeCheckoutBaseline(root, changed, after, { revisions: new Map(), dirs: new Set(['project']), complete: true }, Date.now())).toEqual(changed);
+    expect(await excludeCheckoutBaseline(root, files('logo.png'), { dirs: new Map(), repos: new Set(['']) }, { revisions: new Map(), dirs: new Set(), complete: true }, Date.now())).toEqual(files('logo.png'));
+    rmSync(join(root, 'project/.git'), { recursive: true });
+    expect(await excludeCheckoutBaseline(root, changed, after, null, Date.now())).toEqual(changed);
+  });
+  it('handles real linked worktrees and paths with spaces', async () => {
+    const { root, git } = fixture();
+    const linked = join(root, 'linked worktree'); git('worktree', 'add', '-qb', 'topic', linked);
+    const changed = files('linked worktree/logo.png');
+    expect(await excludeCheckoutBaseline(root, changed, { dirs: new Map([['linked worktree', Date.now()]]), repos: new Set(['linked worktree']) }, null, Date.now())).toEqual([]);
+  }, 30_000);
+});
+
+
+it('does not append a document card for a clean checkout created during the turn', async () => {
+  const { root, git } = fixture();
+  const output = join(root, 'output'); mkdirSync(output);
+  let baseline!: Promise<unknown>;
+  const service = createTurnDocs({ enabled: async () => true, log: () => {}, scan: (dir, notBefore) => {
+    const scan = scannedDocuments(dir, notBefore);
+    if (notBefore !== undefined) baseline = scan;
+    return scan;
+  } });
+  const appended: unknown[] = [];
+  const host = { resolveRoot: async () => output, append: async (_id: string, row: unknown) => { appended.push(row); } };
+  const agent = { id: 'agent', workspaceId: 'workspace', parentAgentId: null, provider: 'fake', cwd: output, title: null };
+  service.turnStarted({ agent, turnId: 'turn' }, host);
+  // Let the asynchronous start hook begin its baseline scan.
+  await new Promise(resolve => setTimeout(resolve, 0));
+  await baseline;
+  git('worktree', 'add', '-qb', 'new-topic', join(output, 'new checkout'));
+  expect(await service.turnEnded({ agent, turnId: 'turn', outcome: { kind: 'completed' }, timeline: [] }, host)).toBeNull();
+  expect(appended).toEqual([]);
+}, 30_000);
+
+
+it('keeps documents authored and committed in a new git-init repository', async () => {
+  const { root } = fixture();
+  const changed = files('origin/logo.png');
+  expect(await excludeCheckoutBaseline(root, changed, { dirs: new Map([['origin', Date.now()]]), repos: new Set(['origin']) }, null, Date.now())).toEqual(changed);
+});
