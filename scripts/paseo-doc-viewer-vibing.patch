diff --git a/server/checkout-baseline.ts b/server/checkout-baseline.ts
new file mode 100644
index 0000000..666726a
--- /dev/null
+++ b/server/checkout-baseline.ts
@@ -0,0 +1,65 @@
+import { execFile } from "node:child_process";
+import { join } from "node:path";
+import { lstat } from "node:fs/promises";
+import { promisify } from "node:util";
+import type { Baseline, ScannedFolders, TurnDocsFile } from "../shared/turn-docs";
+import { TURN_WINDOW_SLACK_MS } from "../shared/turn-docs";
+
+const run = promisify(execFile);
+
+// A clone/worktree stamps every checked-out asset with a fresh timestamp. Only
+// dirty or untracked files inside a new checkout are document changes. Existing
+// repositories keep the ordinary before/after scan, including committed edits.
+export async function excludeCheckoutBaseline(
+  root: string,
+  files: readonly TurnDocsFile[],
+  after: ScannedFolders,
+  baseline: Baseline | null,
+  startedAt: number,
+): Promise<TurnDocsFile[]> {
+  const clean = new Set<string>();
+  // Sequential and bounded: no process per file, no unbounded parallel Git jobs.
+  let checked = 0;
+  for (const repo of after.repos) {
+    // The scan root existed when the turn started; it is never a new checkout.
+    if (!repo) continue;
+    const born = after.dirs.get(repo);
+    const isNew = baseline?.complete ? !baseline.dirs.has(repo) : born != null && born >= startedAt - TURN_WINDOW_SLACK_MS;
+    if (!isNew) continue;
+    const prefix = repo ? `${repo}/` : "";
+    const candidates = files.filter(file => file.path.startsWith(prefix) &&
+      ![...after.repos].some(nested => nested !== repo && nested.length > repo.length && file.path.startsWith(`${nested}/`)));
+    if (checked >= 16) break;
+    if (candidates.length === 0) continue;
+    checked++;
+    try {
+      // NUL output preserves spaces and newlines; disable optional Git writes.
+      // Compare against the creation commit, preserving even edits committed later.
+      const options = { cwd: join(root, repo), timeout: 2_000, maxBuffer: 4 * 1024 * 1024, env: { ...process.env, GIT_OPTIONAL_LOCKS: "0" } };
+      const marker = await lstat(join(root, repo, ".git"));
+      const history = await run("git", ["reflog", "show", "--format=%H%x00%gs", "-n128", "HEAD"], options);
+      const entries = history.stdout.trim().split("\n").filter(Boolean);
+      // A new git-init is authored work, not a checkout baseline. Without complete
+      // creation evidence (expired/disabled/long reflogs), keep the documents.
+      if (entries.length === 0 || entries.length >= 128) continue;
+      const creation = entries.at(-1);
+      if (!creation) continue;
+      const [initial, message] = creation.split("\0");
+      if (!/^[0-9a-f]{40,64}$/.test(initial)) continue;
+      if (!marker.isFile() && !message?.startsWith("clone: from ")) continue;
+      const unstaged = await run("git", ["ls-files", "--modified", "--others", "--exclude-standard", "-z"], options);
+      const tracked = await run("git", ["ls-files", "--cached", "-z"], options);
+      const trackedPaths = new Set(tracked.stdout.split("\0"));
+      const sinceCreation = await run("git", ["diff", "--name-only", "--diff-filter=d", "-z", initial, "--"], options);
+      const dirty = new Set(`${unstaged.stdout}\0${sinceCreation.stdout}`.split("\0"));
+      for (const file of candidates) {
+        const relative = file.path.slice(prefix.length);
+        if (trackedPaths.has(relative) && !dirty.has(relative)) clean.add(file.path);
+      }
+    } catch {
+      // Missing Git, incomplete clones and timeouts cannot prove files untouched.
+      // Keep the scan's result rather than silently losing a real document.
+    }
+  }
+  return files.filter(file => !clean.has(file.path));
+}
