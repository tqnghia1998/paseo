diff --git a/test/vibing-update.test.mjs b/test/vibing-update.test.mjs
new file mode 100644
index 0000000..a4a535c
--- /dev/null
+++ b/test/vibing-update.test.mjs
@@ -0,0 +1,26 @@
+import assert from "node:assert/strict";
+import { test, after } from "node:test";
+import { mkdtemp, writeFile, access, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+const home = await mkdtemp(join(tmpdir(), "polish-update-test-"));
+const marker = join(home, "cli-invoked");
+const cli = join(home, "paseo");
+await writeFile(cli, `#!/bin/sh\ntouch '${marker}'\nprintf '[]'\n`, { mode: 0o700 });
+const previous = process.env.PASEO_CLI;
+process.env.PASEO_CLI = cli;
+const { checkForUpdate, installUpdate } = await import("../server/update.ts");
+after(async () => {
+  if (previous === undefined) delete process.env.PASEO_CLI;
+  else process.env.PASEO_CLI = previous;
+  await rm(home, { recursive: true, force: true });
+});
+test("Vibing's vendored Chat Polish reports local management without invoking the CLI", async () => {
+  assert.deepEqual(await checkForUpdate(), { state: "local", links: [] });
+  await assert.rejects(access(marker));
+});
+test("direct update requests explain local management without invoking the CLI", async () => {
+  const result = await installUpdate();
+  assert.match(result.error ?? "", /Space App Vibing/);
+  await assert.rejects(access(marker));
+});
