+posixTest("concurrent starts reserve capacity before waiting for a spawner", async () => {
+  const h = harness({ terminal: "off", limits: { maxLive: 1 } });
+  const cwd = dir();
+  try {
+    const results = await Promise.allSettled([
+      run(h.registry, "sleep 30", cwd, { runId: "capacity-one" }),
+      run(h.registry, "sleep 30", cwd, { runId: "capacity-two" }),
+    ]);
+    assert.equal(results.filter((result) => result.status === "fulfilled").length, 1);
+    const refused = results.find((result) => result.status === "rejected") as PromiseRejectedResult;
+    assert.match(String(refused.reason), /1 commands are already running/);
+    assert.equal(h.registry.recent(10).filter(({ row }) => row.phase.kind === "running").length, 1);
+  } finally {
+    await h.registry.shutdown();
+  }
+});
+
+posixTest("failed starts release reserved command capacity", async () => {
+  let rejectFirstPublish = true;
+  const h = harness({
+    terminal: "off",
+    limits: { maxLive: 1 },
+    publish: () => {
+      if (rejectFirstPublish) {
+        rejectFirstPublish = false;
+        throw new Error("Unknown agent");
+      }
+    },
+  });
+  const cwd = dir();
+  try {
+    await assert.rejects(run(h.registry, "touch must-not-run", cwd), /Unknown agent/);
+    assert.equal(existsSync(join(cwd, "must-not-run")), false);
+    const recovered = await ended(h.registry, await run(h.registry, "true", cwd));
+    assert.equal(recovered.phase.kind, "ok");
+    const missing = await ended(h.registry, await run(h.registry, "true", join(cwd, "missing")));
+    assert.equal(missing.phase.kind, "failed");
+    const afterMissing = await ended(h.registry, await run(h.registry, "true", cwd));
+    assert.equal(afterMissing.phase.kind, "ok");
+  } finally {
+    await h.registry.shutdown();
+  }
+});
+
+posixTest("shutdown fences a start waiting for its spawner before it can launch", async () => {
+  const h = harness({ terminal: "off" });
+  const cwd = dir();
+  // No await here: shutdown must close admission while start is suspended at its first await.
+  const outcome = run(h.registry, "touch must-not-run", cwd, { runId: "pending-shutdown" }).then(
+    (runId) => ({ kind: "started" as const, runId }),
+    (error: unknown) => ({ kind: "rejected" as const, error }),
+  );
+  try {
+    await h.registry.shutdown();
+    const result = await outcome;
+    assert.equal(result.kind, "rejected");
+    if (result.kind === "rejected") assert.match(String(result.error), /shut|clos|stop/i);
+    await delay(50);
+    assert.equal(existsSync(join(cwd, "must-not-run")), false);
+    assert.equal(
+      h.registry.recent(10).some(({ row }) => row.phase.kind === "running"),
+      false,
+    );
+  } finally {
+    await h.registry.shutdown();
+  }
+});
+
+posixTest("a closed registry rejects new starts without running the command", async () => {
+  const h = harness({ terminal: "off" });
+  const cwd = dir();
+  try {
+    await h.registry.shutdown();
+    await assert.rejects(run(h.registry, "touch must-not-run", cwd), /shut|clos|stop/i);
+    assert.equal(existsSync(join(cwd, "must-not-run")), false);
+  } finally {
+    await h.registry.shutdown();
+  }
+});
+
 posixTest("tail: unknown for an unseen run, unchanged after the wait, wakes on a burst and on the end", { timeout: 15_000 }, async () => {
   // Builtin echoes, so the burst's three writes don't wait on starting a program, which a busy CI
