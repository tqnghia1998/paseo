   assert.deepEqual([h.card(id).runId, h.card(id).phase.kind], [second, "ok"]);
   await h.registry.shutdown();
 });
+
+posixTest("same-id retries share pending admission at the command limit", async () => {
+  const h = harness({ terminal: "off", limits: { maxLive: 1 } });
+  const cwd = dir();
+  try {
+    const ids = await Promise.all([
+      run(h.registry, "sleep 30", cwd, { runId: "same-pending-id" }),
+      run(h.registry, "sleep 30", cwd, { runId: "same-pending-id" }),
+    ]);
+    assert.deepEqual(ids, ["same-pending-id", "same-pending-id"]);
+    assert.equal(h.registry.recent(10).length, 1);
+  } finally {
+    await h.registry.shutdown();
+  }
+});
+
+posixTest("shutdown fences a command waiting for its initial timeline publication", async () => {
+  let release!: () => void;
+  const publication = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  let waiting = false;
+  const h = harness({
+    terminal: "off",
+    limits: { shutdownPublishMs: 10, shutdownKillWaitMs: 10 },
+    publish: (row) => {
+      if (row.phase.kind === "running") {
+        waiting = true;
+        return publication;
+      }
+    },
+  });
+  const cwd = dir();
+  const outcome = run(h.registry, "touch must-not-run", cwd).then(
+    () => "started",
+    () => "rejected",
+  );
+  try {
+    await until(() => waiting);
+    await h.registry.shutdown();
+    release();
+    assert.equal(await outcome, "rejected");
+    await delay(50);
+    assert.equal(existsSync(join(cwd, "must-not-run")), false);
+  } finally {
+    release();
+    await h.registry.shutdown();
+  }
+});
