new file mode 100644
index 0000000..2e96254
--- /dev/null
+++ b/plugins/quick-prompts/client/pills.test.ts
@@ -0,0 +1,36 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createPromptPills } from './pills.ts';
+
+test('draft prompts survive agent snapshots, route Send/Insert, and clean up', async () => {
+  const active = new Map();
+  const sent: unknown[] = [];
+  const inserted: unknown[] = [];
+  const pills = createPromptPills({
+    addComposerPill: (entry) => {
+      active.set(entry.agentId, entry);
+      return { update: (button) => { entry.button = button; }, remove: () => { active.delete(entry.agentId); } };
+    },
+    send: async (...args) => { sent.push(args); },
+    insert: (...args) => { inserted.push(args); },
+    openSettings() {},
+  });
+  pills.setDrafts([{id:'draft', workspaceId:'workspace'}]);
+  pills.setSettings({display:'menu', prompts:[{id:'review',label:'Review',text:'Review this'}]});
+  pills.setAgents([{id:'chat',workspaceId:'workspace'}]);
+  assert.deepEqual([...active.keys()], ['draft','chat']);
+  const menu = active.get('draft');
+  assert.equal(menu.button.label,'Prompts');
+  assert.equal(menu.workspaceId,'workspace');
+  const row = menu.button.behavior.items[0];
+  assert.deepEqual(row.actions.map(action => action.id),['insert']);
+  row.actions[0].onPress();
+  assert.deepEqual(sent,[]);
+  await row.onPress();
+  assert.deepEqual(sent,[['draft','Review this']]);
+  assert.deepEqual(inserted,[['draft','Review this']]);
+  pills.setDrafts([]);
+  assert.deepEqual([...active.keys()],['chat']);
+  pills.removeAll();
+  assert.equal(active.size,0);
+});
