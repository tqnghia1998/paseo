+import { useQueries } from "@tanstack/react-query";
+import { tabBuckets, type TeamTab } from "../../shared/groups";
+import type { ChatBucket } from "../../shared/sidebar";
+import { botChatsQuery, type BotHost } from "../data";
+
+/** Each team tab's status badge, from the bot list's own chat queries (one snapshot in an embedded workspace). */
+export function useTabBuckets(tabs: readonly TeamTab[], resolveHost: (hostId: string | null) => BotHost): Record<string, ChatBucket | null> {
+  const bots = tabs.flatMap((tab) => tab.bots);
+  const results = useQueries({ queries: bots.map((bot) => botChatsQuery(resolveHost(bot.hostId), bot.id)) });
+  const chats = new Map(bots.map((bot, index) => [bot.id, results[index]?.data ?? []]));
+  return tabBuckets(tabs, (botId) => chats.get(botId) ?? []);
+}
