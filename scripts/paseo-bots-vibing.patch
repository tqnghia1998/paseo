diff --git a/tests/vibing-defaults.test.ts b/tests/vibing-defaults.test.ts
new file mode 100644
index 0000000..016c943
--- /dev/null
+++ b/tests/vibing-defaults.test.ts
@@ -0,0 +1,208 @@
+import { describe, expect, it } from "vitest";
+import type { BotSettingsValues } from "../shared/bot";
+import { DEFAULT_BOT_LIST_UI } from "../shared/bot";
+import { LIST_WIDTH } from "../shared/layout";
+import { applyVibingDefaults, CHIEF_BOT_ID, managedChiefBot, CLAUDE_BOT_ID, DEFAULT_BOT_ID, fallbackDefaultBotId, preferredDefaultBotId } from "../shared/vibing-defaults";
+import { makeBot } from "./helpers";
+
+const empty = (): BotSettingsValues => ({ bots: [], history: [] });
+
+describe("applyVibingDefaults", () => {
+  it("creates Codex as the default bot and Claude beside it in a new home", () => {
+    const seeded = applyVibingDefaults(empty())!;
+
+    expect(seeded.bots.map(({ id, name, provider }) => ({ id, name, provider }))).toEqual([
+      { id: DEFAULT_BOT_ID, name: "Codex", provider: "codex" },
+      { id: CLAUDE_BOT_ID, name: "Claude", provider: "claude" },
+      { id: CHIEF_BOT_ID, name: "Chief", provider: "claude" },
+    ]);
+    expect(seeded.bots[0]).toMatchObject({ modeId: "full-access", contactBots: "allow" });
+    expect(seeded.bots[1]).toMatchObject({ modeId: "bypassPermissions", contactBots: "allow" });
+    expect(applyVibingDefaults(seeded)).toBeNull();
+    expect(seeded.bots[0]!.avatar.seed).not.toBe(seeded.bots[1]!.avatar.seed);
+  });
+
+  it("keeps each bot on its own provider even when new bots default to another one", () => {
+    const values = { ...empty(), defaults: { provider: "claude", model: "opus", modeId: "plan", thinkingOptionId: "high", contactBots: "allow" as const } };
+    const [codex, claude] = applyVibingDefaults(values)!.bots;
+
+    expect(codex).toMatchObject({ provider: "codex", model: null, modeId: "full-access", thinkingOptionId: null, contactBots: "allow" });
+    expect(claude).toMatchObject({ provider: "claude", model: "opus", modeId: "bypassPermissions", thinkingOptionId: "high", contactBots: "allow" });
+  });
+
+  it("turns an untouched General bot into Codex once, keeping its instructions and chats' bot id", () => {
+    const general = makeBot({ id: DEFAULT_BOT_ID, name: "General", provider: "claude", model: "sonnet", soul: "Be brief." });
+    const seeded = applyVibingDefaults({ ...empty(), bots: [general, makeBot({ id: "bot-mine", name: "Mine" })] })!;
+
+    expect(seeded.bots.map(({ id }) => id)).toEqual([DEFAULT_BOT_ID, CLAUDE_BOT_ID, "bot-mine", CHIEF_BOT_ID]);
+    expect(seeded.bots[0]).toMatchObject({ name: "Codex", provider: "codex", model: null, soul: "Be brief." });
+  });
+
+  it("preserves a renamed General bot while upgrading its access", () => {
+    const renamed = makeBot({ id: DEFAULT_BOT_ID, name: "Helper", provider: "claude" });
+    const seeded = applyVibingDefaults({ ...empty(), bots: [renamed] })!;
+
+    expect(seeded.bots[0]).toEqual({ ...renamed, modeId: "bypassPermissions", contactBots: "allow" });
+    expect(seeded.bots[1]?.id).toBe(CLAUDE_BOT_ID);
+  });
+
+  it("doesn't recreate a Codex or Claude bot the user deleted", () => {
+    const seeded = applyVibingDefaults(empty())!;
+    const mine = makeBot({ id: "bot-mine", name: "Mine" });
+
+    expect(applyVibingDefaults({ ...seeded, bots: [] })).toBeNull();
+    expect(applyVibingDefaults({ ...seeded, bots: [mine] })).toBeNull();
+  });
+
+  it("names a new home's default bots apart from bots the user already has", () => {
+    const own = makeBot({ id: "bot-own", name: "Codex" });
+    const seeded = applyVibingDefaults({ ...empty(), bots: [own, makeBot({ id: "bot-c", name: "claude" })] })!;
+
+    expect(seeded.bots.map(({ id, name }) => [id, name])).toEqual([
+      [DEFAULT_BOT_ID, "Codex (default)"],
+      [CLAUDE_BOT_ID, "Claude (default)"],
+      ["bot-own", "Codex"],
+      ["bot-c", "claude"],
+      [CHIEF_BOT_ID, "Chief"],
+    ]);
+  });
+
+  it("renames a default bot that shares its name with the user's bot once, on upgrade", () => {
+    const seeded = applyVibingDefaults(empty())!;
+    const clash = {
+      ...seeded,
+      vibingDefaults: 2,
+      bots: [...seeded.bots, makeBot({ id: "bot-own", name: "Codex" }), makeBot({ id: "bot-taken", name: "Codex (default)" })],
+    };
+    const fixed = applyVibingDefaults(clash)!;
+
+    expect(fixed.bots.find((bot) => bot.id === DEFAULT_BOT_ID)?.name).toBe("Codex (default 2)");
+    expect(fixed.bots.find((bot) => bot.id === CLAUDE_BOT_ID)?.name).toBe("Claude");
+    expect(fixed.bots.find((bot) => bot.id === "bot-own")?.name).toBe("Codex");
+    expect(applyVibingDefaults(fixed)).toBeNull();
+    // A later clash is the user's own doing, so it's left alone.
+    expect(applyVibingDefaults({ ...fixed, bots: [...fixed.bots, makeBot({ id: "bot-new", name: "Claude" })] })).toBeNull();
+  });
+
+  it("leaves a default bot the user renamed alone on upgrade", () => {
+    const seeded = applyVibingDefaults(empty())!;
+    const bots = seeded.bots.map((bot) => (bot.id === DEFAULT_BOT_ID ? { ...bot, name: "Mine" } : bot));
+    const upgraded = applyVibingDefaults({ ...seeded, vibingDefaults: 2, bots: [...bots, makeBot({ id: "bot-own", name: "Mine" })] })!;
+
+    expect(upgraded.bots.find((bot) => bot.id === DEFAULT_BOT_ID)?.name).toBe("Mine");
+  });
+
+  it("upgrades existing default bots once without changing other bots or their defaults", () => {
+    const codex = makeBot({ id: DEFAULT_BOT_ID, provider: "codex", modeId: "auto-review", contactBots: "off", name: "My Codex", model: "custom", soul: "Keep this." });
+    const claude = makeBot({ id: CLAUDE_BOT_ID, provider: "claude", modeId: "plan" });
+    const other = makeBot({ id: "bot-own", provider: "codex", modeId: "auto" });
+    const defaults = { provider: "claude", model: null, modeId: "plan", thinkingOptionId: null, contactBots: "off" as const };
+    const upgraded = applyVibingDefaults({ ...empty(), vibingDefaults: 3, bots: [codex, claude, other], defaults })!;
+
+    expect(upgraded.vibingDefaults).toBe(5);
+    expect(upgraded.bots).toEqual([
+      { ...codex, modeId: "full-access", contactBots: "allow" },
+      { ...claude, modeId: "bypassPermissions", contactBots: "allow" },
+      other,
+      managedChiefBot(),
+    ]);
+    expect(upgraded.defaults).toEqual(defaults);
+    const edited = upgraded.bots.map(bot => ({ ...bot, modeId: "plan", contactBots: "off" as const }));
+    expect(applyVibingDefaults({ ...upgraded, bots: edited })).toBeNull();
+  });
+
+  it("does not recreate deleted default bots during the access upgrade", () => {
+    const other = makeBot({ id: "bot-own" });
+    expect(applyVibingDefaults({ ...empty(), vibingDefaults: 3, bots: [other] })!.bots).toEqual([other, managedChiefBot()]);
+  });
+
+  it("uses a default bot's current provider and preserves unsupported provider modes", () => {
+    const switched = makeBot({ id: DEFAULT_BOT_ID, provider: "claude", modeId: "plan" });
+    const custom = makeBot({ id: CLAUDE_BOT_ID, provider: "pi", modeId: "custom" });
+    const upgraded = applyVibingDefaults({ ...empty(), vibingDefaults: 3, bots: [switched, custom] })!;
+    expect(upgraded.bots).toEqual([
+      { ...switched, modeId: "bypassPermissions", contactBots: "allow" },
+      { ...custom, contactBots: "allow" },
+      managedChiefBot(),
+    ]);
+  });
+
+  it("opens the bot list at its minimum width", () => {
+    expect(DEFAULT_BOT_LIST_UI.listWidth).toBe(LIST_WIDTH.min);
+  });
+
+  it("narrows a list still at the old 320px default once, keeping a width the user dragged to", () => {
+    const old = { ...empty(), vibingDefaults: 1, ui: { ...DEFAULT_BOT_LIST_UI, listWidth: 320 } };
+    const narrowed = applyVibingDefaults({ ...old, bots: applyVibingDefaults(empty())!.bots })!;
+    expect(narrowed.ui?.listWidth).toBe(LIST_WIDTH.min);
+    expect(applyVibingDefaults({ ...narrowed, ui: { ...narrowed.ui!, listWidth: 320 } })).toBeNull();
+
+    const dragged = { ...old, ui: { ...old.ui, listWidth: 287 } };
+    expect(applyVibingDefaults({ ...dragged, bots: narrowed.bots })!.ui?.listWidth).toBe(287);
+  });
+});
+
+describe("preferredDefaultBotId", () => {
+  const bots = applyVibingDefaults({ bots: [], history: [] })!.bots;
+  const providers = (codex: string, claude = "ready") => [
+    { provider: "codex", status: codex },
+    { provider: "claude", status: claude },
+  ];
+
+  it("uses Codex when it's ready", () => {
+    expect(preferredDefaultBotId(bots, providers("ready"))).toBe(DEFAULT_BOT_ID);
+  });
+
+  it("falls back to Claude when Codex isn't installed", () => {
+    expect(preferredDefaultBotId(bots, providers("unavailable"))).toBe(CLAUDE_BOT_ID);
+    expect(preferredDefaultBotId(bots, [{ provider: "claude", status: "ready" }])).toBe(CLAUDE_BOT_ID);
+  });
+
+  it("waits while providers or Codex are still loading", () => {
+    expect(preferredDefaultBotId(bots, undefined)).toBeUndefined();
+    expect(preferredDefaultBotId(bots, providers("loading"))).toBeUndefined();
+  });
+
+  it("waits for the default bots to be seeded", () => {
+    expect(preferredDefaultBotId([], providers("unavailable"))).toBeUndefined();
+  });
+
+  it("waits for Claude's check when Codex can't run", () => {
+    expect(preferredDefaultBotId(bots, providers("unavailable", "loading"))).toBeUndefined();
+  });
+
+  it("keeps Codex when Claude can't run either, or the Claude bot was deleted", () => {
+    expect(preferredDefaultBotId(bots, providers("error", "unavailable"))).toBe(DEFAULT_BOT_ID);
+    expect(preferredDefaultBotId(bots.filter((bot) => bot.id !== CLAUDE_BOT_ID), providers("unavailable"))).toBe(DEFAULT_BOT_ID);
+  });
+
+  it("follows the bots' own providers after the user changes them", () => {
+    const edited = bots.map((bot) => (bot.id === DEFAULT_BOT_ID ? { ...bot, provider: "claude" } : bot));
+    expect(preferredDefaultBotId(edited, providers("unavailable"))).toBe(DEFAULT_BOT_ID);
+  });
+
+  it("skips a Claude bot that lives on another host", () => {
+    const remote = bots.map((bot) => (bot.id === CLAUDE_BOT_ID ? { ...bot, hostId: "other" } : bot));
+    expect(preferredDefaultBotId(remote, providers("unavailable"), "local")).toBe(DEFAULT_BOT_ID);
+  });
+
+  it("opens on Claude, then the first bot here, when Codex was deleted", () => {
+    const withoutCodex = bots.filter((bot) => bot.id !== DEFAULT_BOT_ID);
+    const mine = makeBot({ id: "bot-mine", name: "Mine" });
+    expect(preferredDefaultBotId([...withoutCodex, mine], providers("ready", "unavailable"))).toBe(CLAUDE_BOT_ID);
+    expect(preferredDefaultBotId([mine], providers("ready"))).toBe("bot-mine");
+    expect(preferredDefaultBotId([{ ...mine, hostId: "other" }], providers("ready"), "local")).toBeUndefined();
+  });
+});
+
+describe("fallbackDefaultBotId", () => {
+  const [codex, claude] = applyVibingDefaults({ bots: [], history: [] })!.bots;
+  const mine = makeBot({ id: "bot-mine", name: "Mine" });
+
+  it("prefers Codex, then Claude, then the first bot on this host", () => {
+    expect(fallbackDefaultBotId([mine, claude!, codex!])).toBe(DEFAULT_BOT_ID);
+    expect(fallbackDefaultBotId([mine, claude!])).toBe(CLAUDE_BOT_ID);
+    expect(fallbackDefaultBotId([{ ...mine, hostId: "other" }, makeBot({ id: "bot-here", name: "Here" })], "local")).toBe("bot-here");
+    expect(fallbackDefaultBotId([])).toBeUndefined();
+  });
+});
