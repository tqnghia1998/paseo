@@ -0,0 +1,51 @@
+/** How many deletes run at once; each closes its agent, so a long list shouldn't hit the host all together. */
+export const DELETE_CHATS_CONCURRENCY = 4;
+
+export interface DeleteChatsResult {
+  deleted: string[];
+  failed: { id: string; error: unknown }[];
+}
+
+/** Deletes chats a few at a time, carrying on past failures so one bad chat doesn't strand the rest. */
+export async function deleteChats(
+  ids: readonly string[],
+  remove: (id: string) => Promise<void>,
+  concurrency = DELETE_CHATS_CONCURRENCY,
+): Promise<DeleteChatsResult> {
+  const outcomes = new Map<string, { error: unknown } | null>();
+  let next = 0;
+  const worker = async () => {
+    while (next < ids.length) {
+      const id = ids[next++]!;
+      try {
+        await remove(id);
+        outcomes.set(id, null);
+      } catch (error) {
+        outcomes.set(id, { error });
+      }
+    }
+  };
+  await Promise.all(Array.from({ length: Math.min(Math.max(concurrency, 1), ids.length) }, worker));
+  const result: DeleteChatsResult = { deleted: [], failed: [] };
+  for (const id of ids) {
+    const outcome = outcomes.get(id);
+    if (outcome) result.failed.push({ id, error: outcome.error });
+    else result.deleted.push(id);
+  }
+  return result;
+}
+
+/** The confirmation for deleting every chat of a bot. `running` chats are stopped by deleting them. */
+export function deleteAllChatsMessage(botName: string, count: number, running: number): string {
+  const base =
+    count === 1
+      ? `Delete the 1 chat of "${botName}"? This permanently removes it and can't be undone.`
+      : `Delete all ${count} chats of "${botName}"? This permanently removes them and can't be undone.`;
+  if (running === 0) return base;
+  return `${base}\n\n${running === 1 ? "1 is still running" : `${running} are still running`} and will be stopped.`;
+}
+
+/** The pinned chats that survive deleting `deleted`. */
+export function pinsWithout<T extends { chatId: string }>(pins: readonly T[], deleted: ReadonlySet<string>): T[] {
+  return pins.filter((pin) => !deleted.has(pin.chatId));
+}
