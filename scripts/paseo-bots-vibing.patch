+++ b/server/chief.ts
@@ -0,0 +1,181 @@
+import { timingSafeEqual } from "node:crypto";
+import { constants } from "node:fs";
+import { lstat, open, realpath } from "node:fs/promises";
+import { isAbsolute, join, relative, resolve, sep } from "node:path";
+import { homedir } from "node:os";
+import { z } from "zod";
+import { localDay } from "../shared/activity";
+import { BOT_LABEL, botSkills, composeSystemPrompt, type Bot } from "../shared/bot";
+import { assertOrdinaryBot, CHIEF_BOT_ID } from "../shared/vibing-defaults";
+import { startChat } from "./chats";
+import type { Relay } from "./relay";
+import { ASKED_BY_LABEL } from "./tools/bots";
+import { botDataPath, ensureBotHome, pluginDataPath } from "./bot-home";
+import type { BotsHost } from "./host";
+import { MemoryJournal } from "./journal";
+import { librarySkillPath, sha256 } from "./library";
+import { memoryFilePath } from "./memory";
+import { promptContext } from "./prompt";
+import { BOT_TOOLS } from "./tools";
+import type { ToolCaller } from "./tools/mcp";
+
+export const CHIEF_POLICY_LABEL = "paseo-chief.policy";
+export const CHIEF_POLICY = "chief-v1";
+const BridgeToken = z.string().min(32).max(512);
+const MemoryName = z.string().max(120).regex(/^[A-Za-z0-9 _-][A-Za-z0-9 ._-]*\.md$/);
+const SkillId = z.string().min(1).max(100).regex(/^[A-Za-z0-9_-][A-Za-z0-9._-]*$/);
+// General Bot tools stay scoped to Chief; feature replies use the gateway chat reader.
+const READ_ONLY = new Set(["list_bots", "search_chats", "get_setup"]);
+/** Written on a handoff chat: the Bot's display name when Chief started it. */
+export const HANDOFF_BOT_NAME_LABEL = "paseo-chief.bot-name";
+const HANDOFF_LABEL = "paseo-chief.handoff";
+const MAX_FILE_BYTES = 512 * 1024;
+
+/** Reject symlinks throughout the plugin-owned path, not just at its final filename. */
+async function safePath(path: string): Promise<void> {
+  const home = resolve(process.env.PASEO_HOME || resolve(homedir(), ".paseo"));
+  const rel = relative(home, path);
+  if (isAbsolute(rel) || rel === ".." || rel.startsWith(`..${sep}`)) throw new Error("Unsafe Chief file path");
+  let current = home;
+  for (const part of ["", ...rel.split(sep)]) {
+    current = resolve(current, part);
+    const info = await lstat(current).catch((error: NodeJS.ErrnoException) => {
+      if (error.code === "ENOENT") return null;
+      throw error;
+    });
+    if (info?.isSymbolicLink()) throw new Error("Chief files cannot be symlinks");
+    if (info && current !== path && !info.isDirectory()) throw new Error("Unsafe Chief file parent");
+    if (info && current === path && (!info.isFile() || info.size > MAX_FILE_BYTES)) throw new Error("Unsafe or oversized Chief file");
+  }
+}
+async function safeRead(path: string, allowMissing = true): Promise<string> {
+  await safePath(path);
+  const file = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW).catch((error: NodeJS.ErrnoException) => {
+    if (error.code === "ENOENT") return null;
+    throw error;
+  });
+  if (!file) {
+    if (!allowMissing) throw new Error("Reviewed skill file is missing");
+    return "";
+  }
+  try {
+    const info = await file.stat();
+    if (!info.isFile() || info.size > MAX_FILE_BYTES) throw new Error("Unsafe or oversized Chief file");
+    // Bounded even if another writer grows the file after stat.
+    const bytes = Buffer.alloc(MAX_FILE_BYTES + 1);
+    const { bytesRead } = await file.read(bytes, 0, bytes.length, 0);
+    if (bytesRead > MAX_FILE_BYTES) throw new Error("Oversized Chief file");
+    return bytes.subarray(0, bytesRead).toString("utf8");
+  } finally { await file.close(); }
+}
+
+/**
+ * Private daemon broker. The daemon must reserve these RPCs from ordinary clients,
+ * bind before exposing agents, and keep the random token out of model-visible data.
+ * A token cannot be replaced during this plugin incarnation. No labels alone grant access.
+ */
+export class ChiefBroker {
+  private token: string | null = null;
+  private identity: { agentId: string; cwd: string } | null = null;
+  constructor(private readonly host: BotsHost, private readonly journal: MemoryJournal, private readonly relay: Relay) {}
+
+  private authorize(token: string): void {
+    const candidate = BridgeToken.parse(token);
+    if (!this.token || !timingSafeEqual(Buffer.from(sha256(this.token)), Buffer.from(sha256(candidate)))) throw new Error("Chief broker authorization failed");
+  }
+  async prepare({ bridgeToken, agentId, cwd }: { bridgeToken: string; agentId: string; cwd: string }): Promise<{ botId: typeof CHIEF_BOT_ID; systemPrompt: string }> {
+    BridgeToken.parse(bridgeToken);
+    // This bootstrap is reachable only through the daemon's private broker dispatcher.
+    if (this.token === null) this.token = bridgeToken;
+    this.authorize(bridgeToken);
+    const identity = { agentId: z.string().min(1).max(200).parse(agentId), cwd: await realpath(z.string().min(1).max(4096).parse(cwd)) };
+    this.identity = identity;
+    const bot = (await this.host.bot(CHIEF_BOT_ID))!;
+    await safePath(memoryFilePath(CHIEF_BOT_ID, "MEMORY.md"));
+    await ensureBotHome({ botId: CHIEF_BOT_ID });
+    return { botId: CHIEF_BOT_ID, systemPrompt: await this.persona(bot) };
+  }
+  private async skills(bot: Bot): Promise<{ id: string; description: string; text: string }[]> {
+    const result = [];
+    for (const skill of botSkills(bot, await this.host.library())) {
+      if (!SkillId.safeParse(skill.id).success || !skill.reviewedSha) continue;
+      const text = await safeRead(resolve(librarySkillPath(skill.id), "SKILL.md"), false);
+      if (sha256(text) === skill.reviewedSha) result.push({ id: skill.id, description: skill.description, text });
+    }
+    return result;
+  }
+  private async persona(bot: Bot): Promise<string> {
+    z.string().regex(/^[a-z0-9-]+$/).parse(bot.id);
+    await safePath(memoryFilePath(bot.id, "MEMORY.md"));
+    const now = new Date();
+    for (let back = 0; back < 3; back++) {
+      const day = localDay(new Date(now.getFullYear(), now.getMonth(), now.getDate() - back));
+      await safePath(join(botDataPath(bot.id), "memory", "log", `${day}.md`));
+    }
+    const skills = await this.skills(bot);
+    // Feed only verified skills to the existing composer. No generic tools or connected apps.
