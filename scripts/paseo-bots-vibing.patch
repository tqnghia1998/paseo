diff --git a/tests/worktree-chats.test.tsx b/tests/worktree-chats.test.tsx
new file mode 100644
index 0000000..6c99a68
--- /dev/null
+++ b/tests/worktree-chats.test.tsx
@@ -0,0 +1,34 @@
+// @vitest-environment jsdom
+import React, { type ReactNode } from "react";
+import { renderHook, waitFor, cleanup } from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { afterEach, expect, it, vi } from "vitest";
+vi.mock("@getpaseo/plugin/client", () => ({ getPaseoClient: vi.fn(), usePaseo: vi.fn(), useHosts: vi.fn() }));
+import { useBotChats, type BotHost } from "../client/data";
+import type { PaseoApi, PaseoAgent } from "../client/paseo";
+const agent = (id: string, cwd: string, botId = "review") => ({ id, cwd, labels: { "paseo-bots.bot": botId }, archivedAt: null, updatedAt: "2026-10-20T00:00:00Z" }) as unknown as PaseoAgent;
+afterEach(cleanup);
+function setup() {
+  const list = vi.fn(async () => ({ entries: [agent("one-chat", "/one"), agent("two-chat", "/two"), agent("other-bot", "/one", "other")].map(agent => ({agent})), pageInfo: {hasMore: false, nextCursor: null} }));
+  const host: BotHost = { api: { agents: { list } } as unknown as PaseoApi, key: "local", label: "Local", isLocal: true, online: true, workspaceDirectory: "/one" };
+  const cache = new QueryClient({defaultOptions: {queries: {retry: false}}});
+  const wrapper = ({children}: {children: ReactNode}) => <QueryClientProvider client={cache}>{children}</QueryClientProvider>;
+  return {host, list, wrapper};
+}
+it("shows only the selected bot's chats in the current worktree, including after switching back", async () => {
+  const {host,wrapper} = setup();
+  const view = renderHook(({directory}) => useBotChats({...host, workspaceDirectory: directory}, "review"), {initialProps: {directory: "/one"}, wrapper});
+  await waitFor(() => expect(view.result.current.data?.map(chat => chat.id)).toEqual(["one-chat"]));
+  view.rerender({directory: "/two"});
+  expect(view.result.current.data?.some(chat => chat.id === "one-chat")).not.toBe(true);
+  await waitFor(() => expect(view.result.current.data?.map(chat => chat.id)).toEqual(["two-chat"]));
+  view.rerender({directory: "/one"});
+  await waitFor(() => expect(view.result.current.data?.map(chat => chat.id)).toEqual(["one-chat"]));
+});
+it("does not expose another host's chats in a local worktree", async () => {
+  const {host,wrapper,list} = setup();
+  const view = renderHook(() => useBotChats({...host,isLocal:false}, "review"), {wrapper});
+  await new Promise(resolve => setTimeout(resolve, 0));
+  expect(list).not.toHaveBeenCalled();
+  expect(view.result.current.data ?? []).toEqual([]);
+});
