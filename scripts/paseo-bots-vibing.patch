new file mode 100644
index 0000000..1249067
--- /dev/null
+++ b/client/NativeChat.ts
@@ -0,0 +1,20 @@
+import type { ComponentType } from "react";
+import type { Bot } from "../shared/bot";
+import type { OutgoingMessage } from "./ChatPane";
+
+/** Optional host-owned chat UI; upstream/older hosts retain the plugin UI. */
+export interface NativeChatProps {
+  serverId: string;
+  botId: string;
+  agentId: string | null;
+  workspaceId?: string | null;
+  cwd: string;
+  provider: Bot["provider"];
+  model?: string | null;
+  modeId?: string | null;
+  thinkingOptionId?: string | null;
+  active: boolean;
+  onSelectChat(agentId: string | null): void;
+  onStart(message: OutgoingMessage): Promise<void>;
+}
+export interface NativeChatSlot { nativeChat?: ComponentType<NativeChatProps>; }
