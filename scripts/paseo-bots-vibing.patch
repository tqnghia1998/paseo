+import { makeBot } from "./helpers";
+
+describe("managed Chief settings policy", () => {
+  it("hides every Chief settings section and rejects every personalization patch", () => {
+    for (const section of ["overview", "identity", "soul", "skills", "memory", "playbooks"]) expect(botSectionAllowed(CHIEF_BOT_ID, section)).toBe(false);
+    for (const section of ["model", "permissions", "access", "routines", "history", "usage"]) expect(botSectionAllowed(CHIEF_BOT_ID, section)).toBe(false);
+    expect(chiefPersonalizationPatch(CHIEF_BOT_ID, { soul: "Be brief", skillIds: ["review"], provider: "codex", cwd: "/tmp", routines: [], alwaysAllow: ["*"] })).toEqual({});
+    expect(chiefPersonalizationPatch("ordinary", { provider: "codex" })).toEqual({ provider: "codex" });
+    expect(botSectionAllowed("ordinary", "routines")).toBe(true);
+  });
+  it("excludes Chief from bulk export without affecting ordinary bots", () => {
+    const ordinary = makeBot();
+    expect(exportableBots([managedChiefBot(), ordinary])).toEqual([ordinary]);
+    expect(userBots([managedChiefBot(), ordinary])).toEqual([ordinary]);
+  });
+});
+
+import { applyChanges, botDetails, setupOverview } from "../shared/changes";
+import { BotGroupSchema } from "../shared/bot";
+import { userSettings } from "../shared/managed-chief-ui";
+it("hides Chief from setup details, proposals and stale team membership", () => {
+  const ordinary = makeBot();
+  const group = BotGroupSchema.parse({id:"team",name:"Team",memberIds:[CHIEF_BOT_ID,ordinary.id],leadId:CHIEF_BOT_ID,createdAt:"now",updatedAt:"now"});
+  const values = {bots:[managedChiefBot(),ordinary],history:[],groups:[group]};
+  const visible = userSettings(values);
+  expect(visible.groups?.[0]?.memberIds).toEqual([ordinary.id]);
+  expect(visible.groups?.[0]?.leadId).toBeNull();
+  expect(visible.bots).toEqual([ordinary]);
+  expect(setupOverview(values,null,null)).not.toContain(CHIEF_BOT_ID);
+  expect(() => botDetails({bots:values.bots,history:[]},CHIEF_BOT_ID)).toThrow(/no bot/i);
+  expect(() => applyChanges({bots:values.bots,history:[]},[{type:"delete_bot",bot:CHIEF_BOT_ID}],{now:"now",provider:"claude"})).toThrow(/no bot/i);
+})
