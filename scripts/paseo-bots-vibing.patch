+import { DEFAULT_BOT_DEFAULTS, type Bot, type BotSettingsValues } from "./bot";
+import { LIST_WIDTH } from "./layout";
+import { BOT_TEMPLATES, newBot } from "./templates";
+
+/**
+ * The default bot: chats without a bot label belong to it, and a workspace opens on it.
+ * It's created once per home like Claude, so deleting it sticks.
+ */
+export const DEFAULT_BOT_ID = "vibing-general";
+export const CLAUDE_BOT_ID = "vibing-claude";
+/**
+ * Bumped when Vibing's defaults change; each home is migrated once per version.
+ * 1: Codex and Claude default bots. 2: the bot list opens at its minimum width.
+ * 3: a default bot whose name another bot already uses gets a distinct name.
+ * 4: default bots have full access and may contact other bots.
+ * 5: a reserved host-managed Chief persona.
+ */
+export const VIBING_DEFAULTS_VERSION = 5;
+/** Reserved host-managed identity. Configuration is owned entirely by Vibing source. */
+export const CHIEF_BOT_ID = "vibing-chief";
+export function managedChiefBot(): Bot {
+  const base = newBot("claude", BOT_TEMPLATES[0]);
+  return {
+    ...base, id: CHIEF_BOT_ID, name: "Chief",
+    provider: "claude", model: "sonnet", modeId: null, thinkingOptionId: null,
+    soul: "", skillIds: [], playbooks: [],
+    avatar: { ...base.avatar, seed: CHIEF_BOT_ID },
+    contactBots: "off", apps: [], appRules: {}, mcpServerIds: [], alwaysAllow: [],
+    routines: [], cwd: null, hostId: null, archived: false,
+    createdAt: "2026-11-07T00:00:00.000Z",
+    updatedAt: "2026-11-07T00:00:00.000Z",
+  };
+}
+export function assertOrdinaryBot(botId: string): void {
+  if (botId === CHIEF_BOT_ID) throw new Error("Chief requires the host-managed execution path; ordinary chats, routines and relay tools are unavailable.");
+}
+
+/** The list width every home was saved with before version 2. */
+const OLD_LIST_WIDTH = 320;
+const DEFAULT_BOT_MODES = new Map([
+  ["codex", "full-access"],
+  ["claude", "bypassPermissions"],
+]);
+
+function defaultBot(id: string, name: string, provider: string, values: BotSettingsValues): Bot {
+  const defaults = values.defaults ?? DEFAULT_BOT_DEFAULTS;
+  // A model or thinking level only means something for the provider it was picked for.
+  const same = defaults.provider === provider;
+  const base = newBot(provider, BOT_TEMPLATES[0]);
+  return {
+    ...base,
+    id,
+    name,
+    // Distinct avatars, so the two default bots are told apart in the sidebar.
+    avatar: { ...base.avatar, seed: `vibing-${provider}` },
+    model: same ? defaults.model : null,
+    modeId: DEFAULT_BOT_MODES.get(provider) ?? null,
+    thinkingOptionId: same ? defaults.thinkingOptionId : null,
+    contactBots: "allow",
+  };
+}
+
+/** Version 1: Codex (the default) and Claude; an untouched General bot becomes Codex. */
+function seedDefaultBots(values: BotSettingsValues, migrating: boolean): Bot[] {
+  if (!migrating) return values.bots;
+  let bots = values.bots;
+  const current = bots.find((bot) => bot.id === DEFAULT_BOT_ID);
+  if (!current) {
+    bots = [defaultBot(DEFAULT_BOT_ID, "Codex", "codex", values), ...bots];
+  } else if (current.name === "General") {
+    const codex = defaultBot(DEFAULT_BOT_ID, "Codex", "codex", values);
+    const converted = { ...current, name: codex.name, provider: codex.provider, model: codex.model, modeId: codex.modeId, thinkingOptionId: codex.thinkingOptionId };
+    bots = bots.map((bot) => (bot.id === DEFAULT_BOT_ID ? converted : bot));
+  }
+  if (!bots.some((bot) => bot.id === CLAUDE_BOT_ID)) {
+    const at = bots.findIndex((bot) => bot.id === DEFAULT_BOT_ID) + 1;
+    bots = [...bots.slice(0, at), defaultBot(CLAUDE_BOT_ID, "Claude", "claude", values), ...bots.slice(at)];
+  }
+  return bots;
