+describe("preferredDefaultBotId", () => {
+  const bots = applyVibingDefaults({ bots: [], history: [] })!.bots;
+  const providers = (codex: string, claude = "ready") => [
+    { provider: "codex", status: codex },
+    { provider: "claude", status: claude },
+  ];
+
+  it("uses Codex when it's ready", () => {
+    expect(preferredDefaultBotId(bots, providers("ready"))).toBe(DEFAULT_BOT_ID);
+  });
+
+  it("falls back to Claude when Codex isn't installed", () => {
+    expect(preferredDefaultBotId(bots, providers("unavailable"))).toBe(CLAUDE_BOT_ID);
+    expect(preferredDefaultBotId(bots, [{ provider: "claude", status: "ready" }])).toBe(CLAUDE_BOT_ID);
+  });
+
+  it("waits while providers or Codex are still loading", () => {
+    expect(preferredDefaultBotId(bots, undefined)).toBeUndefined();
+    expect(preferredDefaultBotId(bots, providers("loading"))).toBeUndefined();
+  });
+
+  it("waits for the default bots to be seeded", () => {
+    expect(preferredDefaultBotId([], providers("unavailable"))).toBeUndefined();
+  });
+
+  it("waits for Claude's check when Codex can't run", () => {
+    expect(preferredDefaultBotId(bots, providers("unavailable", "loading"))).toBeUndefined();
+  });
+
+  it("keeps Codex when Claude can't run either, or the Claude bot was deleted", () => {
+    expect(preferredDefaultBotId(bots, providers("error", "unavailable"))).toBe(DEFAULT_BOT_ID);
+    expect(preferredDefaultBotId(bots.filter((bot) => bot.id !== CLAUDE_BOT_ID), providers("unavailable"))).toBe(DEFAULT_BOT_ID);
+  });
+
+  it("follows the bots' own providers after the user changes them", () => {
+    const edited = bots.map((bot) => (bot.id === DEFAULT_BOT_ID ? { ...bot, provider: "claude" } : bot));
+    expect(preferredDefaultBotId(edited, providers("unavailable"))).toBe(DEFAULT_BOT_ID);
+  });
+
+  it("skips a Claude bot that lives on another host", () => {
+    const remote = bots.map((bot) => (bot.id === CLAUDE_BOT_ID ? { ...bot, hostId: "other" } : bot));
+    expect(preferredDefaultBotId(remote, providers("unavailable"), "local")).toBe(DEFAULT_BOT_ID);
+  });
+
+  it("opens on Claude, then the first bot here, when Codex was deleted", () => {
+    const withoutCodex = bots.filter((bot) => bot.id !== DEFAULT_BOT_ID);
+    const mine = makeBot({ id: "bot-mine", name: "Mine" });
+    expect(preferredDefaultBotId([...withoutCodex, mine], providers("ready", "unavailable"))).toBe(CLAUDE_BOT_ID);
+    expect(preferredDefaultBotId([mine], providers("ready"))).toBe("bot-mine");
+    expect(preferredDefaultBotId([{ ...mine, hostId: "other" }], providers("ready"), "local")).toBeUndefined();
+  });
+});
