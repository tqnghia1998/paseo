index 0000000..ad544ef
--- /dev/null
+++ b/client/teams/tabChats.ts
@@ -0,0 +1,44 @@
+import { useRef } from "react";
+import type { TabChat } from "../../shared/groups";
+import { readItem, readItemSync, writeItem } from "../chat/composer/storage";
+
+// The chat last opened on each team tab, so switching tabs goes back to it. Kept per
+// place (an embedded workspace and its chat context, or the whole host), best effort.
+
+const KEY = "paseo-bots:tab-chats:";
+
+function parse(value: string | null): Record<string, TabChat> {
+  try {
+    const saved: unknown = JSON.parse(value ?? "{}");
+    if (!saved || typeof saved !== "object") return {};
+    const entries = Object.entries(saved as Record<string, Partial<TabChat>>).filter(
+      ([, chat]) => typeof chat?.botId === "string" && (chat.chatId === null || typeof chat.chatId === "string") && (chat.draftId === undefined || typeof chat.draftId === "string"),
+    );
+    return Object.fromEntries(entries.map(([tab, chat]) => [tab, { botId: chat.botId!, chatId: chat.chatId!, ...(chat.draftId ? { draftId: chat.draftId } : {}) }]));
+  } catch {
+    return {};
+  }
+}
+
+export function useTabChats(scope: string) {
+  const key = KEY + scope;
+  const state = useRef<{ key: string; chats: Record<string, TabChat> } | null>(null);
+  if (state.current?.key !== key) {
+    const loaded = { key, chats: parse(readItemSync(key)) };
+    state.current = loaded;
+    // Phones read storage asynchronously; tabs opened meanwhile win.
+    void readItem(key).then((value) => {
+      if (state.current === loaded) loaded.chats = { ...parse(value), ...loaded.chats };
+    });
+  }
+  const current = state.current;
+  return {
+    get: (tabId: string): TabChat | undefined => current.chats[tabId],
+    remember(tabId: string, chat: TabChat) {
+      const previous = current.chats[tabId];
+      if (previous?.botId === chat.botId && previous.chatId === chat.chatId && previous.draftId === chat.draftId) return;
+      current.chats = { ...current.chats, [tabId]: { botId: chat.botId, chatId: chat.chatId, ...(chat.draftId ? { draftId: chat.draftId } : {}) } };
+      void writeItem(key, JSON.stringify(current.chats));
+    },
+  };
+}
