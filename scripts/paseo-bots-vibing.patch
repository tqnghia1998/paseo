+import { deleteAllChatsMessage, deleteChats, pinsWithout } from "../shared/delete-chats";
+
+// BotDialogs pulls in React Native; the menu builder needs none of it.
+vi.mock("@getpaseo/plugin/client", () => ({ useRpc: () => vi.fn() }));
+vi.mock("@getpaseo/plugin/client/react-native", () => ({}));
+vi.mock("@getpaseo/plugin/client/ui", () => ({}));
+vi.mock("react-native", () => ({ Platform: { OS: "web" } }));
+vi.mock("../client/Avatar", () => ({}));
+vi.mock("../client/native", () => ({}));
+vi.mock("../client/panel/controls", () => ({}));
+vi.mock("../client/web", () => ({}));
+
+const { botMenuEntries } = await import("../client/BotDialogs");
+const { makeBot } = await import("./helpers");
+
+function actions(overrides: Record<string, unknown> = {}) {
+  const noop = vi.fn();
+  return {
+    bot: makeBot(),
+    onOpenSettings: noop,
+    onTogglePin: noop,
+    onRename: noop,
+    onDuplicate: async () => {},
+    onExport: noop,
+    onCopyId: noop,
+    onSaveAsPreset: noop,
+    onToggleArchive: noop,
+    onDeleteAllChats: async () => {},
+    onDelete: async () => {},
+    ...overrides,
+  };
+}
+
+describe("botMenuEntries: Delete all chats", () => {
+  it("sits between Archive and Delete bot as a destructive action that runs only its own handler", () => {
+    const onDeleteAllChats = vi.fn(async () => {});
+    const onDelete = vi.fn(async () => {});
+    const onToggleArchive = vi.fn();
+    const entries = botMenuEntries(actions({ onDeleteAllChats, onDelete, onToggleArchive }));
+    const labels = entries.flatMap((entry) => ("label" in entry ? [entry.label] : []));
+
+    expect(labels.slice(-3)).toEqual(["Archive bot", "Delete all chats", "Delete bot"]);
+    const entry = entries.find((candidate) => "label" in candidate && candidate.label === "Delete all chats");
+    expect(entry).toMatchObject({ icon: "Trash2", destructive: true, pendingLabel: "Deleting..." });
+    if (entry && "onSelect" in entry) void entry.onSelect?.();
+    expect(onDeleteAllChats).toHaveBeenCalledOnce();
+    expect(onDelete).not.toHaveBeenCalled();
+    expect(onToggleArchive).not.toHaveBeenCalled();
+  });
+});
+
+describe("scopeBotChats", () => {
+  const chat = (id: string, cwd: string, labels: Record<string, string> = {}) => ({ id, cwd, labels: { [BOT_LABEL]: "bot-a", ...labels } });
+  const agents = [
+    chat("mine", "/work/app"),
+    chat("other-bot", "/work/app", { [BOT_LABEL]: "bot-b" }),
+    chat("other-dir", "/work/other"),
+    chat("live-design", "/work/app", { [CHAT_CONTEXT_LABEL]: "live-design" }),
+  ];
+
+  it("keeps everything outside an embedded workspace, where the query is already filtered by bot", () => {
+    expect(scopeBotChats(agents, { isLocal: true }, "bot-a")).toEqual(agents);
+  });
+
+  it("keeps only the bot's chats for this workspace and chat context", () => {
+    expect(scopeBotChats(agents, { directory: "/work/app/", isLocal: true }, "bot-a").map(({ id }) => id)).toEqual(["mine"]);
+    expect(scopeBotChats(agents, { directory: "/work/app", isLocal: true, chatContext: "live-design" }, "bot-a").map(({ id }) => id)).toEqual(["live-design"]);
+  });
+
+  it("lists nothing for a remote host in an embedded workspace", () => {
+    expect(scopeBotChats(agents, { directory: "/work/app", isLocal: false }, "bot-a")).toEqual([]);
+  });
+});
+
+describe("deleteChats", () => {
+  it("deletes every chat, never more than the limit at once", async () => {
+    let active = 0;
+    let peak = 0;
+    const ids = Array.from({ length: 10 }, (_, index) => `chat-${index}`);
+    const result = await deleteChats(
+      ids,
+      async () => {
+        active += 1;
+        peak = Math.max(peak, active);
+        await new Promise((resolve) => setTimeout(resolve, 2));
+        active -= 1;
+      },
+      3,
+    );
+
+    expect(result.deleted).toEqual(ids);
+    expect(result.failed).toEqual([]);
+    expect(peak).toBeLessThanOrEqual(3);
+  });
+
+  it("keeps going after a failure and reports exactly which chats failed", async () => {
+    const error = new Error("host went away");
+    const result = await deleteChats(["a", "b", "c", "d"], async (id) => {
+      if (id === "b") throw error;
+    });
+
+    expect(result.deleted).toEqual(["a", "c", "d"]);
+    expect(result.failed).toEqual([{ id: "b", error }]);
+  });
+
+  it("does nothing for an empty list", async () => {
+    const remove = vi.fn();
+    expect(await deleteChats([], remove)).toEqual({ deleted: [], failed: [] });
+    expect(remove).not.toHaveBeenCalled();
+  });
+});
+
+describe("deleteAllChatsMessage", () => {
+  it("names the bot and the count, and warns it can't be undone", () => {
+    expect(deleteAllChatsMessage("Codex", 1, 0)).toBe('Delete the 1 chat of "Codex"? This permanently removes it and can\'t be undone.');
+    expect(deleteAllChatsMessage("Codex", 12, 0)).toBe('Delete all 12 chats of "Codex"? This permanently removes them and can\'t be undone.');
+  });
+
+  it("says running chats are stopped", () => {
+    expect(deleteAllChatsMessage("Codex", 3, 1)).toContain("1 is still running and will be stopped.");
+    expect(deleteAllChatsMessage("Codex", 5, 2)).toContain("2 are still running and will be stopped.");
+  });
+});
+
+describe("pinsWithout", () => {
+  it("drops the pins of deleted chats and keeps every other pin", () => {
+    const pins = [
+      { botId: "bot-a", chatId: "gone" },
+      { botId: "bot-a", chatId: "kept" },
+      { botId: "bot-b", chatId: "other" },
+    ];
+    expect(pinsWithout(pins, new Set(["gone", "other-but-not-deleted"]))).toEqual([
+      { botId: "bot-a", chatId: "kept" },
+      { botId: "bot-b", chatId: "other" },
+    ]);
+  });
+});
