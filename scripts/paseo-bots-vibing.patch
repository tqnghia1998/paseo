@@ -0,0 +1,31 @@
+import type { ComponentType } from "react";
+import type { Bot } from "../shared/bot";
+import type { OutgoingMessage } from "./ChatPane";
+
+/** Optional host-owned chat UI; upstream/older hosts retain the plugin UI. */
+export interface NativeChatProps {
+  serverId: string;
+  botId: string;
+  draftId?: string;
+  agentId: string | null;
+  workspaceId?: string | null;
+  cwd: string;
+  provider: Bot["provider"];
+  model?: string | null;
+  modeId?: string | null;
+  thinkingOptionId?: string | null;
+  active: boolean;
+  onSelectChat(agentId: string | null, draftId?: string): void;
+  onStart(message: OutgoingMessage): Promise<string>;
+}
+export interface BotWorkspace { id: string; directory: string; }
+export interface BotWorkspaceBridgeProps {
+  selectedAgentId?: string | null;
+  botId: string;
+  onActivate(target: { botId?: string; agentId?: string; draftId?: string }): void;
+}
+export interface NativeChatSlot {
+  nativeChat?: ComponentType<NativeChatProps>;
+  botWorkspace?: BotWorkspace;
+  workspaceBridge?: ComponentType<BotWorkspaceBridgeProps>;
+}
