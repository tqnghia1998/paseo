+describe("chatMenuEntries", () => {
+  it("leads with Rename, which runs only its own action", () => {
+    const onRename = vi.fn();
+    const noop = vi.fn();
+    const entries = chatMenuEntries({
+      pinned: false,
+      onCopyPath: noop,
+      onCopyId: noop,
+      onCopyTranscript: async () => {},
+      onTogglePin: noop,
+      onRename,
+      move: null,
+      onArchive: async () => {},
+    });
+    const first = entries[0];
+    expect(first).toMatchObject({ label: "Rename", icon: "Pencil" });
+    if (first && "onSelect" in first) void first.onSelect?.();
+    expect(onRename).toHaveBeenCalledOnce();
+    expect(noop).not.toHaveBeenCalled();
+  });
+});
