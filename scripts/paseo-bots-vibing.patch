+  }),
+}));
+vi.mock("../client/native", () => ({
+  nativeTokens: () => ({ surfaceSidebarSelected: "rgb(50, 50, 60)" }),
+  useHover: () => ({ hovered: false, hoverProps: {} }),
+}));
+vi.mock("../client/ui/Tooltip", () => ({ tooltip: () => ({}) }));
+vi.mock("../client/ui/Menu", () => ({
+  contextMenuProps: () => ({}),
+  measureAnchor: async () => ({ x: 0, y: 0, width: 20, height: 20 }),
+  useMenu: () => ({ open: vi.fn() }),
+}));
+import { BotSidebar } from "../client/BotSidebar";
+import { DEFAULT_BOT_LIST_UI } from "../shared/bot";
+import { makeBot } from "./helpers";
+
+afterEach(cleanup);
+
+it.each([false, true])(
+  "keeps the chat actions on the row's visible surface while held and released (selected=%s)",
+  (selected) => {
+    const onSelect = vi.fn(),
+      onDeleteChat = vi.fn();
+    render(
+      <BotSidebar
+        {...({
+          colors: { surface1: "rgb(30, 30, 40)", surface2: "rgb(60, 60, 70)" },
+          bots: [makeBot()],
+          openTab: null,
+          hiddenArchivedCount: 0,
+          selection: selected ? { botId: "bot-1", chatId: "chat" } : null,
+          ui: DEFAULT_BOT_LIST_UI,
+          localHost: {},
+          touch: false,
+          bottomInset: 0,
+          onSelect,
+          onDeleteChat,
+        } as any)}
+      />,
+    );
+    const target = screen.getByRole("button", { name: "Hi, Done" });
+    const row = target.parentElement!;
+    fireEvent.pointerEnter(row);
+    const actions = screen.getByRole("button", { name: "Chat actions" }).parentElement!;
+    const surface = () =>
+      target.style.backgroundColor && target.style.backgroundColor !== "transparent"
+        ? target.style.backgroundColor
+        : row.style.backgroundColor;
+    expect(actions.style.backgroundColor).toBe(surface());
+    fireEvent.mouseDown(target);
+    expect(surface()).toBe("rgb(60, 60, 70)");
+    expect(actions.style.backgroundColor).toBe(surface());
+    expect(actions.previousElementSibling?.getAttribute("style")).toContain(surface());
+    expect(onSelect).not.toHaveBeenCalled();
+    expect(onDeleteChat).not.toHaveBeenCalled();
+    fireEvent.mouseUp(target);
+    expect(actions.style.backgroundColor).toBe(surface());
+    expect(surface()).toBe(selected ? "rgb(50, 50, 60)" : "rgb(30, 30, 40)");
+    fireEvent.click(target);
+    expect(onSelect).toHaveBeenCalledWith({ botId: "bot-1", chatId: "chat" });
+  },
+);
