+describe("fallbackDefaultBotId", () => {
+  const [codex, claude] = applyVibingDefaults({ bots: [], history: [] })!.bots;
+  const mine = makeBot({ id: "bot-mine", name: "Mine" });
+
+  it("prefers Codex, then Claude, then the first bot on this host", () => {
+    expect(fallbackDefaultBotId([mine, claude!, codex!])).toBe(DEFAULT_BOT_ID);
+    expect(fallbackDefaultBotId([mine, claude!])).toBe(CLAUDE_BOT_ID);
