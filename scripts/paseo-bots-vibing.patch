+    ({ children, style, onPointerEnter, onPointerLeave }: any, ref: any) => (
+      <div
+        ref={ref}
+        style={background(style)}
+        onPointerEnter={onPointerEnter}
+        onPointerLeave={onPointerLeave}
+      >
+        {children}
+      </div>
+    ),
+  );
+  const Pressable = React.forwardRef(
+    ({ children, style, onPress, onPressIn, onPressOut, accessibilityLabel }: any, ref: any) => {
+      const [pressed, setPressed] = React.useState(false);
+      return (
+        <button
+          ref={ref}
+          aria-label={accessibilityLabel}
+          style={background(typeof style === "function" ? style({ pressed }) : style)}
+          onClick={onPress}
+          onMouseDown={() => {
+            setPressed(true);
+            onPressIn?.();
+          }}
+          onMouseUp={() => {
+            setPressed(false);
+            onPressOut?.();
+          }}
+          onBlur={() => {
+            setPressed(false);
+            onPressOut?.();
+          }}
+        >
+          {typeof children === "function" ? children({ pressed }) : children}
+        </button>
+      );
+    },
+  );
+  return {
+    Animated: {
+      Value: class {
+        interpolate() {
+          return 0;
+        }
+      },
+    },
+    Easing: {},
+    View,
+    Pressable,
+    Text: ({ children }: any) => <span>{children}</span>,
+    Platform: { OS: "web" },
+  };
+});
+vi.mock("../client/panel/controls", () => ({ SearchField: () => null }));
+vi.mock("../client/Avatar", () => ({ Avatar: () => null }));
+vi.mock("../client/Splash", () => ({ Splash: () => null }));
