+/**
+ * Version 3: a default bot still under its seeded name, when another bot already has that
+ * name (one the user made before the defaults arrived), becomes "Codex (default)" or
+ * "Claude (default)", so the sidebar never shows two bots with the same name. A name the
+ * user picked for the default bot is left alone.
+ */
+function distinctDefaultNames(bots: Bot[]): Bot[] {
+  let result = bots;
+  for (const [id, seededName] of DEFAULT_BOT_NAMES) {
+    const bot = result.find((entry) => entry.id === id);
+    if (!bot || nameKey(bot.name) !== nameKey(seededName)) continue;
+    const taken = new Set(result.filter((entry) => entry.id !== id).map((entry) => nameKey(entry.name)));
+    if (!taken.has(nameKey(seededName))) continue;
+    let name = `${seededName} (default)`;
+    for (let n = 2; taken.has(nameKey(name)); n++) name = `${seededName} (default ${n})`;
+    result = result.map((entry) => (entry.id === id ? { ...entry, name } : entry));
+  }
+  return result;
+}
+
+/** Version 4: upgrade only the two reserved default bots, using their current providers. */
+function fullAccessDefaultBots(bots: Bot[]): Bot[] {
+  return bots.map((bot) =>
+    bot.id === DEFAULT_BOT_ID || bot.id === CLAUDE_BOT_ID
+      ? { ...bot, modeId: DEFAULT_BOT_MODES.get(bot.provider) ?? bot.modeId, contactBots: "allow" }
+      : bot,
+  );
+}
+
+/**
+ * Applies Vibing's defaults to the Bots settings. Every step runs once per home, so later
+ * choices stick: deleting Codex or Claude, renaming General, or dragging the list to any
+ * width. Returns null when nothing changes.
+ */
+export function applyVibingDefaults(values: BotSettingsValues): BotSettingsValues | null {
+  const from = values.vibingDefaults ?? 0;
+  const seeded = seedDefaultBots(values, from < 1);
+  const named = from < 3 ? distinctDefaultNames(seeded) : seeded;
+  const upgraded = from < 4 ? fullAccessDefaultBots(named) : named;
+  const bots = from < 5 && !upgraded.some((bot) => bot.id === CHIEF_BOT_ID) ? [...upgraded, managedChiefBot()] : upgraded;
+  // Before version 2 the list was saved at 320px unless the user dragged it, which
+  // never lands on exactly 320, so that value means "still the default".
+  const ui = from < 2 && values.ui?.listWidth === OLD_LIST_WIDTH ? { ...values.ui, listWidth: LIST_WIDTH.min } : values.ui;
+  if (from >= VIBING_DEFAULTS_VERSION && bots === values.bots) return null;
+  return { ...values, bots, ...(ui ? { ui } : {}), vibingDefaults: VIBING_DEFAULTS_VERSION };
+}
+
+/**
+ * The bot a workspace falls back to when it can't wait for the preferred one: Codex,
+ * else Claude, else the first bot on this host. Undefined when this host has no bots.
+ */
+export function fallbackDefaultBotId(bots: readonly Bot[], hostId?: string): string | undefined {
+  const local = bots.filter((bot) => bot.id !== CHIEF_BOT_ID && (!bot.hostId || bot.hostId === hostId));
+  return (local.find((bot) => bot.id === DEFAULT_BOT_ID) ?? local.find((bot) => bot.id === CLAUDE_BOT_ID) ?? local[0])?.id;
+}
+
+/**
+ * The bot a workspace opens on: Codex, unless its provider can't run here (not installed
+ * or failing) and the Claude bot's can. Undefined while that's still unknown, so callers
+ * wait instead of opening Codex and switching. Each bot's own provider decides, so a
+ * user's provider change is respected. Without Codex it's Claude, and without both the
+ * first bot on this host.
+ */
+export function preferredDefaultBotId(
+  bots: readonly Bot[],
+  providers: readonly { provider: string; status: string }[] | undefined,
+  hostId?: string,
+): string | undefined {
+  // Before the bots load there is nothing to choose between yet.
+  if (!providers || bots.length === 0) return undefined;
+  const codex = bots.find((bot) => bot.id === DEFAULT_BOT_ID && (!bot.hostId || bot.hostId === hostId));
+  if (!codex) return fallbackDefaultBotId(bots, hostId);
+  const statusOf = (bot: Bot) => providers.find((entry) => entry.provider === bot.provider)?.status ?? "unavailable";
+  const status = statusOf(codex);
+  if (status === "ready") return DEFAULT_BOT_ID;
+  if (status === "loading") return undefined;
+  const claude = bots.find((bot) => bot.id === CLAUDE_BOT_ID && (!bot.hostId || bot.hostId === hostId));
+  if (!claude) return DEFAULT_BOT_ID;
+  const claudeStatus = statusOf(claude);
+  if (claudeStatus === "loading") return undefined;
+  return claudeStatus === "ready" ? CLAUDE_BOT_ID : DEFAULT_BOT_ID;
+}
