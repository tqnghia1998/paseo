+/// <reference lib="dom" />
+// @vitest-environment jsdom
+import { Blob as NodeBlob } from "node:buffer";
+import { afterEach, expect, it, vi } from "vitest";
+
+vi.mock("react-native", () => ({ Platform: { OS: "web" } }));
+import { downloadBotFile } from "../client/web";
+
+afterEach(() => { vi.restoreAllMocks(); vi.unstubAllGlobals(); vi.useRealTimers(); });
+
+it("downloads a portable JSON file with a safe name and intact Unicode", async () => {
+  vi.useFakeTimers();
+  vi.stubGlobal("Blob", NodeBlob);
+  const json = JSON.stringify({ name: "Nghĩa 🤖", soul: "你好" });
+  let downloaded: Blob | undefined;
+  const create = vi.fn((blob: Blob) => { downloaded = blob; return "blob:bot-export"; });
+  const revoke = vi.fn();
+  vi.stubGlobal("URL", { createObjectURL: create, revokeObjectURL: revoke });
+  const click = vi.spyOn(HTMLAnchorElement.prototype, "click").mockImplementation(function (this: HTMLAnchorElement) {
+    expect(this.download).toBe("Nghĩa-review.bot.json");
+    expect(this.href).toBe("blob:bot-export");
+    expect(document.body.contains(this)).toBe(true);
+  });
+  downloadBotFile("../Nghĩa / review", json);
+  expect(click).toHaveBeenCalledOnce();
+  expect(downloaded?.type).toBe("application/json;charset=utf-8");
+  const text = await (downloaded as unknown as NodeBlob).text();
+  expect(text).toBe(json);
+  expect(document.querySelector("a")).toBeNull();
+  vi.runAllTimers();
+  expect(revoke).toHaveBeenCalledWith("blob:bot-export");
+});
